{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "olive/*": [
        "src/*"
      ],
      "pako/dist/pako": [
        "node_modules/pako/dist/pako"
      ]
    },
    "module": "amd",
    "target": "ES2018",
    "outFile": "dist/bundle.js",
    "inlineSourceMap": true,
    "noImplicitAny": false,
    "noEmitOnError": true,
    "removeComments": false,
    "skipLibCheck": true,
    "strict": false,
    "lib": [ "ES2019", "DOM" ],
    "types": []
  },
  "include": [
    "src/**/*.ts",
    "typings-lib/index.d.ts"
  ],
  "exclude": [
    "typings",
    "dist",
    "node_modules"
  ],
  "compileOnSave": true
}